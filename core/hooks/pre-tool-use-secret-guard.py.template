#!/usr/bin/env python3
"""Pre-tool-use secret guard for Claude Code (template, off by default).

This file is staged into target repos at .agent/hooks/pre-tool-use-secret-guard.py
when bootstrap is run with --install-hook=secret-guard or --install-hook=both.
Bootstrap never registers it. The repository owner must:

  1. Verify the current Claude Code PreToolUse input/output schema in the
     official Anthropic hooks documentation. Schemas evolve; this template
     targets `hookSpecificOutput.permissionDecision`.
  2. Decide whether the protected-path policy below matches the repo's
     threat model and adjust the lists as needed.
  3. Register the hook manually in the harness configuration (for example,
     .claude/settings.json). Bootstrap does not edit harness settings.

Behavior contract:
  - Reads a PreToolUse JSON payload from stdin.
  - Denies a write attempt against a protected path with a JSON object on
    stdout that contains only hookSpecificOutput.{hookEventName,
    permissionDecision, permissionDecisionReason}. Exits 0.
  - Allows everything else by exiting 0 with no stdout. This includes:
    non-write tools, write tools on non-protected paths, and malformed
    JSON. Fail-open is intentional for a staged template so that schema
    drift cannot accidentally block sessions.
  - Never echoes the incoming payload, and never reads or prints
    tool_input.content. The deny reason is constructed from the path only.
"""

from __future__ import annotations

import json
import sys


WRITE_TOOLS = frozenset({"Edit", "Write", "MultiEdit"})

PROTECTED_BASENAMES = frozenset({
    ".env",
    "credentials",
    "credentials.json",
    ".npmrc",
    ".pypirc",
    "id_rsa",
    "id_ed25519",
})

PROTECTED_BASENAME_PREFIXES = (
    ".env.",
)

PROTECTED_PATH_SUFFIXES = (
    ".aws/credentials",
    ".agent/rulebase.md",
    ".agent/gates.md",
)

PROTECTED_PATH_SEGMENTS = frozenset({
    "secrets",
    ".ssh",
})


def normalize_segments(path: str) -> list[str]:
    parts: list[str] = []
    for segment in path.replace("\\", "/").split("/"):
        if segment in ("", "."):
            continue
        parts.append(segment)
    return parts


def is_protected(path: str) -> bool:
    if not path:
        return False
    parts = normalize_segments(path)
    if not parts:
        return False
    basename = parts[-1]
    if basename in PROTECTED_BASENAMES:
        return True
    for prefix in PROTECTED_BASENAME_PREFIXES:
        if basename.startswith(prefix):
            return True
    posix = "/".join(parts)
    for suffix in PROTECTED_PATH_SUFFIXES:
        if posix == suffix or posix.endswith("/" + suffix):
            return True
    if PROTECTED_PATH_SEGMENTS.intersection(parts):
        return True
    return False


def emit_deny(path: str) -> None:
    decision = {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": (
                f"Path {path} is protected by .agent/ secret-guard hook. "
                "If this edit is intentional, follow .agent/workflows/rule-evolution-workflow.md "
                "and request explicit human approval."
            ),
        }
    }
    sys.stdout.write(json.dumps(decision))


def main() -> int:
    raw = sys.stdin.read()
    try:
        payload = json.loads(raw or "{}")
    except json.JSONDecodeError:
        return 0
    if not isinstance(payload, dict):
        return 0

    tool_name = payload.get("tool_name")
    if tool_name not in WRITE_TOOLS:
        return 0

    tool_input = payload.get("tool_input") or {}
    if not isinstance(tool_input, dict):
        return 0

    raw_path = tool_input.get("file_path") or tool_input.get("path") or ""
    if not isinstance(raw_path, str):
        return 0

    if not is_protected(raw_path):
        return 0

    emit_deny(raw_path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
